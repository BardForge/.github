  "milestones": [
    {
      "title": "v0.1.0 — Audio MVP",
      "description": "Рабочее локальное аудиоядро: импорт аудио, микшер, группы, громкость и сцены. Foundry — необязательная отдельно подключаемая интеграция. Для приёмки интеграции обязательны подтверждённая проверка в Foundry и удалённое воспроизведение на другом клиенте; локальный тест транспорта не заменяет эту проверку.",
      "aliases": ["v0.1.0", "v0.1.0 - Audio MVP", "Audio MVP"]
    },
    {
      "title": "v0.2.0 — Mixer Improvements",
      "description": "Предварительное направление: улучшения микшера и управления дорожками. Состав работ уточняется по обратной связи; это не обещание реализации или даты выпуска.",
      "aliases": ["v0.2.0", "v0.2.0 - Mixer Improvements"]
    },
    {
      "title": "v0.3.0 — Workspace",
      "description": "Предварительное направление: организация рабочего пространства. Состав работ уточняется; это не обещание реализации или даты выпуска.",
      "aliases": ["v0.3.0", "v0.3.0 - Workspace"]
    },
    {
      "title": "Future",
      "description": "Идеи и задачи вне подтверждённого ближайшего объёма. Приоритет, состав и сроки не обещаны.",
